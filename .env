# Token del bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Client ID de la aplicación (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=

# Opcional: si lo pones, los comandos slash se registran solo en este servidor
# (instantáneo, ideal para desarrollo). Si lo dejas vacío, se registran
# globalmente (puede tardar hasta 1 hora en propagarse).
GUILD_ID=

# Base URL de la API compatible con Ergast (sucesora oficial tras el cierre de Ergast a fines de 2024)
ERGAST_BASE_URL=https://api.jolpi.ca/ergast/f1

# Base URL de OpenF1 (datos de sesión / tiempo real)
OPENF1_BASE_URL=https://api.openf1.org/v1
